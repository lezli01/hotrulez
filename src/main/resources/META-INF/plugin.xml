<idea-plugin>
    <id>dev.lezli.hotrulez</id>
    <name>Firebase Rules (HotRulez)</name>
    <vendor email="lezli01@gmail.com" url="https://lezli01.is-a.dev">lezli01</vendor>

    <description><![CDATA[
        <p>
            Language support for <b>Firebase Security Rules</b> &mdash; both
            <b>Cloud Firestore</b> and <b>Cloud Storage</b> &mdash; in
            <code>.rules</code> files in JetBrains IDEs. The dialect (service name,
            root match shape, and <code>request</code>/<code>resource</code>
            members) is detected from the <code>service</code> declaration in each
            file.
        </p>
        <p>Features:</p>
        <ul>
            <li>Syntax highlighting with a configurable color scheme</li>
            <li>Structural validation and inspections (file-structure and
                suspicious-usage warnings)</li>
            <li><b>Unknown-member inspection</b> &mdash; a conservative,
                dialect-aware weak warning when a member access on a closed
                built-in (<code>request</code>, <code>resource</code>, &hellip;)
                names a member that dialect does not define, with did-you-mean
                rename fixes; it never flags user data, custom auth claims, or
                object metadata, and infers no types</li>
            <li>Code formatting, brace matching, quote handling, and line/block
                commenting</li>
            <li><b>Symbol intelligence</b> &mdash; go to definition, find usages,
                and rename for functions, parameters, <code>let</code> bindings,
                and path variables, with Firebase-aware scoping and
                path-variable shadowing</li>
            <li><b>Scope-aware code completion</b> for keywords,
                <code>allow</code> operations, in-scope symbols, built-ins
                (<code>request</code>, <code>resource</code>), helper functions,
                and shallow <code>request.</code>/<code>resource.</code>
                members</li>
            <li><b>Structure view</b> &mdash; a navigable outline of the file's
                services, matches, functions, and <code>allow</code> rules</li>
            <li><b>Code folding</b> for service, match, and function blocks and
                block comments</li>
            <li><b>Quick documentation</b> (Ctrl+Q) &mdash; doc-grounded
                descriptions with an external Firebase link for operations,
                built-ins, dialect-correct members, and helpers, plus signatures
                for your own functions, parameters, <code>let</code> bindings,
                and path variables</li>
            <li><b>Parameter info</b> (Ctrl+P) for user-function and fixed-arity
                path-helper calls</li>
        </ul>
        <p>
            HotRulez is purely structural: it never connects to Firebase, runs
            the emulator, or evaluates whether a rule authorizes a request.
        </p>
        <p>
            <em>This is an unofficial, community-maintained open-source plugin.
            Firebase, Cloud Firestore, and Cloud Storage for Firebase are
            trademarks of Google LLC; HotRulez is not affiliated with, endorsed
            by, or sponsored by Google.</em>
        </p>
        <p>
            HotRulez is free and open source &mdash; if it saves you time, you can
            <a href="https://www.buymeacoffee.com/lezli01"><b>buy me a coffee</b></a>.
            Thank you!
        </p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Firebase Rules"
            implementationClass="dev.lezli.hotrulez.FirebaseRulesFileType"
            fieldName="INSTANCE"
            language="FirebaseRules"
            extensions="rules"/>

        <lang.syntaxHighlighterFactory
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.highlighting.FirebaseRulesSyntaxHighlighterFactory"/>

        <annotator
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.highlighting.FirebaseRulesAnnotator"/>

        <colorSettingsPage
            implementation="dev.lezli.hotrulez.highlighting.FirebaseRulesColorSettingsPage"/>

        <lang.parserDefinition
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.parser.FirebaseRulesParserDefinition"/>

        <lang.formatter
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.formatting.FirebaseRulesFormattingModelBuilder"/>

        <lang.braceMatcher
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.editor.FirebaseRulesBraceMatcher"/>

        <lang.quoteHandler
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.editor.FirebaseRulesQuoteHandler"/>

        <lang.commenter
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.editor.FirebaseRulesCommenter"/>

        <annotator
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.diagnostics.FirebaseRulesAnnotator"/>

        <localInspection
            language="FirebaseRules"
            shortName="FirebaseRulesStructure"
            displayName="Firebase Rules file structure"
            groupName="Firebase Rules"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="dev.lezli.hotrulez.diagnostics.FirebaseRulesStructureInspection"/>

        <localInspection
            language="FirebaseRules"
            shortName="FirebaseRulesUsage"
            displayName="Firebase Rules suspicious usage"
            groupName="Firebase Rules"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="dev.lezli.hotrulez.diagnostics.FirebaseRulesUsageInspection"/>

        <localInspection
            language="FirebaseRules"
            shortName="FirebaseRulesSymbol"
            displayName="Firebase Rules unresolved and unused symbols"
            groupName="Firebase Rules"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="dev.lezli.hotrulez.diagnostics.FirebaseRulesSymbolInspection"/>

        <localInspection
            language="FirebaseRules"
            shortName="FirebaseRulesMember"
            displayName="Firebase Rules unknown member"
            groupName="Firebase Rules"
            enabledByDefault="true"
            level="WEAK WARNING"
            implementationClass="dev.lezli.hotrulez.diagnostics.FirebaseRulesMemberInspection"/>

        <!-- Symbol intelligence (v2): resolve/go-to-definition, find usages, rename, completion.
             References are attached directly on the PSI (see
             FirebaseRulesReferenceExpressionMixin.getReference()), so no
             psi.referenceContributor is registered. -->
        <lang.elementManipulator
            forClass="dev.lezli.hotrulez.psi.impl.FirebaseRulesReferenceExpressionImpl"
            implementationClass="dev.lezli.hotrulez.references.FirebaseRulesReferenceManipulator"/>

        <lang.findUsagesProvider
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.findusages.FirebaseRulesFindUsagesProvider"/>

        <lang.namesValidator
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.refactoring.FirebaseRulesNamesValidator"/>

        <completion.contributor
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.completion.FirebaseRulesCompletionContributor"/>

        <renamePsiElementProcessor
            implementation="dev.lezli.hotrulez.refactoring.FirebaseRulesPathVariableRenameProcessor"/>

        <!-- Authoring polish (v0.8): structure view, folding, quick documentation, parameter info. -->
        <lang.psiStructureViewFactory
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.structureview.FirebaseRulesStructureViewFactory"/>

        <lang.foldingBuilder
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.folding.FirebaseRulesFoldingBuilder"/>

        <lang.documentationProvider
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.documentation.FirebaseRulesDocumentationProvider"/>

        <codeInsight.parameterInfo
            language="FirebaseRules"
            implementationClass="dev.lezli.hotrulez.parameterinfo.FirebaseRulesParameterInfoHandler"/>
    </extensions>
</idea-plugin>
